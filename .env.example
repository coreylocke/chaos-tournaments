# Site
NEXT_PUBLIC_SITE_URL=https://chaostournaments.com

# Supabase (Section 4 / Section 56 Phase 1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Discord OAuth (configured in Discord Developer Portal + Supabase Auth providers)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Discord automation (Section 3 / Section 61) — webhook notifications for team/tournament
# events, "hands-off for owner." Channel Settings > Integrations > Webhooks > New Webhook.
DISCORD_WEBHOOK_URL=

# Stripe (Phase 3)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Discord bot (Section 49, scoped subset — see docs/MASTER_BUILD_BRIEF.md addendum). Shared
# by both the `web` and `bot` Docker services (same .env file, docker-compose.yml sets
# BOT_INTERNAL_URL for `web` automatically — don't set it here).
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
BOT_INTERNAL_SECRET=
# Optional tuning, both have sane defaults if unset:
# BOT_INTERNAL_PORT=4001
# CHECKIN_REMINDER_LEAD_MINUTES=30
# CHECKIN_REMINDER_POLL_MS=300000

# Firecrawl (Section 61 — web data / crawling for content enrichment)
# Use FIRECRAWL_API_KEY for the hosted API, or FIRECRAWL_API_URL if self-hosting.
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=

# Higgsfield (Section 61 — AI video/image generation for hype content, Phase 8)
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_URL=

# n8n (workflow automation — Section 3)
N8N_WEBHOOK_URL=
